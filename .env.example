# ──────────────────────────────────────────────
# Firebase Configuration — REQUIRED for contact form
# ──────────────────────────────────────────────
# Get these from Firebase Console:
#   Project Settings → General → Your apps → Web app → Config
#
# Steps:
# 1. Use the same Firebase project as the dashboard
# 2. Go to Firestore → Create a collection called "contacts"
# 3. Copy the config values below
#
# ==============================================

VITE_FIREBASE_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Dashboard URL (where users sign in)
VITE_DASHBOARD_URL=https://trading.sachinnaik.in
