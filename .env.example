# ═══════════════════════════════════════════════════════════════
# AutoTrader Landing — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your Firebase project keys.
# The contact form on the Pricing page requires Firestore.
#
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# Firebase Configuration — get these from Firebase Console → Project Settings
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Dashboard URL (where the main AutoTrader application runs)
# Default: http://localhost:5173
VITE_DASHBOARD_URL=
